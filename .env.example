# 数据库（SQLite 文件，位于 data/ 目录，不入库）
DATABASE_URL=sqlite+aiosqlite:///./data/daily_report.db
REDIS_URL=redis://localhost:6379/0

# 大模型
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat

# 飞书开放平台
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8000/api/auth/feishu/callback

# 应用
APP_ENV=dev
APP_PORT=8000
