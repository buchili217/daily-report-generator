# 数据库（SQLite 文件，位于 data/ 目录，不入库）
DATABASE_URL=sqlite:///./data/daily_report.db
REDIS_URL=redis://localhost:6379/0

# 应用
APP_ENV=dev
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
# 必填：会话与令牌加密密钥，生产环境请使用随机值
APP_SECRET_KEY=
# 开发期使用 Mock 采集器，无需真实凭证
MOCK_MODE=true

# 大模型
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20

# 飞书开放平台
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8000/api/oauth/feishu/callback
# 前端地址：OAuth 回调后跳转到这里完成登录
FRONTEND_BASE_URL=http://localhost:5173

# GitHub
GITHUB_TOKEN=
GITHUB_REPOS=
# GitHub 登录名：用于匹配你提交的 PR；留空则用成员邮箱前缀
GITHUB_LOGIN=

# 邮件推送（P2，可留空）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 定时任务
DAILY_RUN_HOUR=17
DAILY_RUN_MINUTE=30
